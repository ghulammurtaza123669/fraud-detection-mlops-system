{
  "uid": "fraud-detection-mlops",
  "title": "Fraud Detection MLOps",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{"expr": "sum(rate(fraud_api_requests_total[1m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "targets": [{"expr": "sum(rate(fraud_api_errors_total[1m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "P95 Latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(fraud_api_request_latency_seconds_bucket[5m])) by (le))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "stat",
      "title": "Fraud Predictions",
      "targets": [{"expr": "sum(fraud_predictions_total{prediction=\"1\"})"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Container CPU",
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"fraud-detection-api.*\"}[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "timeseries",
      "title": "Container Memory",
      "targets": [{"expr": "sum(container_memory_working_set_bytes{pod=~\"fraud-detection-api.*\"})"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ]
}
